# Neon — copia la connection string desde el dashboard de neon.tech (Connection Details, modo "pooled")
DATABASE_URL=

# Backblaze B2 — desde el dashboard de Backblaze: App Keys > Add a New Application Key
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
# Endpoint S3-compatible del bucket, formato: https://s3.<region>.backblazeb2.com (region visible en Buckets > tu bucket > Endpoint)
B2_ENDPOINT=

# WhatsApp — número al que llegan los mensajes de compra, formato internacional sin +
NEXT_PUBLIC_WHATSAPP_NUMBER=51999999999

# GitHub — para que el CMS suba las fotos de producto como commits (no van a B2).
# Token: github.com/settings/personal-access-tokens/new, tipo "Fine-grained",
# acceso restringido SOLO a este repo, permiso "Contents: Read and write".
GITHUB_TOKEN=
GITHUB_REPO=zerovibraspe/zero-market
GITHUB_BRANCH=main

# Auth simple del CMS (MVP, sin sistema de usuarios ni base de datos de credenciales)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Secreto para firmar la cookie de sesión del admin — genera uno con: openssl rand -base64 32
ADMIN_SESSION_SECRET=
